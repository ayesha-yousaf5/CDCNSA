# Copy to .env and fill in. Never commit the real .env.
GROQ_API_KEY=
# Alibaba Cloud Model Studio (Qwen-VL) — enables the visual diagnosis.
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen3-vl-plus
# International (Singapore) key:
QWEN_VL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China (Beijing) key instead:
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set to "cnn" to switch the visual model off.
CDCNSA_DIAGNOSIS_MODE=hybrid
