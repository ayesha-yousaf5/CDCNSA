# Copy to .env and fill in. Never commit the real .env.
# The Groq key powers BOTH the chatbot and the photo diagnosis
# (Qwen vision model qwen/qwen3.8-27b on Groq). Nothing else is required.
GROQ_API_KEY=

# Optional: use Alibaba Cloud Model Studio instead (needs an Alibaba account).
# DASHSCOPE_API_KEY=
# QWEN_VL_MODEL=qwen3-vl-plus

# Set to "cnn" to switch the visual model off and use only the CNN models.
CDCNSA_DIAGNOSIS_MODE=hybrid
