# Copy to .env and fill in. Never commit the real .env.

# Chatbot (Kisan Dost) key - Groq
GROQ_API_KEY=

# Photo check (Qwen vision) key - a SECOND Groq key, so the photo check's per-minute limit
# never stops the chatbot. If left empty, the chatbot key above is used for both.
GROQ_VISION_API_KEY=

# Optional: use Alibaba Cloud Model Studio for the photo check instead (needs an Alibaba account).
# DASHSCOPE_API_KEY=
# QWEN_VL_MODEL=qwen3-vl-plus

# Set to "cnn" to switch the online photo check off and use only our trained models.
CDCNSA_DIAGNOSIS_MODE=hybrid
